# The Dreamcast build, with KallistiOS: make -f Makefile.dc  ->  port/build/dc/bt3.elf
# (source /opt/toolchains/dc/kos/environ.sh first; the game's data tables come from the PC build's `make`).
#
# The same game sources as the PC build (Makefile), through the same cc_ee.py, compiled by kos-cc. The port's own
# code is the PC build's minus what the Dreamcast has no use for (the Vulkan and OpenGL renderers, the settings
# window on imgui, SDL's sound and input), plus port/src/dc (KOS: the start, the pad, what SDL did). Sound is the
# null output (port/src/null, as the PC's AUDIO=none) until the AICA one is written. Everything is hardware float
# (the PC build's software float for the game cannot be mixed with hardware-float code in the SH-4's calling
# convention). Not run yet: it links, with stubs for what is still missing (link_dc.py).

ifndef KOS_BASE
$(error the Dreamcast build needs the KOS environment: source /opt/toolchains/dc/kos/environ.sh)
endif

BUILD  := port/build/dc
OBJ    := $(BUILD)/obj
DATA   := $(BUILD)/obj_data
GEN_GS := port/build/gen/gs
EXE    := $(BUILD)/bt3.elf
PYTHON := .venv/bin/python

CC  := kos-cc
CXX := kos-c++

# ------------------------------------------------------------------------------------------------- the sources

REPLACED := src/sys/vu0_a_c.c src/sys/vu0_a_c_b.c src/sys/vu0_a_c_c.c src/sys/vu0_b_c.c
GAME_SRC := src/main.c $(filter-out $(REPLACED),$(sort $(wildcard src/sys/*.c src/battle/*.c src/menu/*.c)))
NL_SRC   := $(sort $(wildcard port/third_party/newlib_libm/*.c))
VU0_SRC  := src/port/vu0_a.c src/port/vu0_b.c
# the PC's only: its renderers, SDL's window, sound, input and screen reader; texture packs; online play
GS_PC    := gs_gpu.c gs_gl.c gs_window.c audio_sdl.c gs_input.c a11y.c gs_texpack.c net.c net_chat.c net_match.c net_relay.c net_sign.c state.c
# (MP3 songs converted to ADX in the PC's songs folder: song_mp3.c; with plat_songs.c, answered by port/src/null/songs_null.c)
GS_PC    += song_mp3.c
# (the TrueType menu fonts and the lettering of added names: answered by port/src/null/menutext_null.c)
GS_PC    += menu_text.c menu_labels.c namefont.c
# and the PS2 reference, what the PC compares records against: the GS (GS memory, the packets) and VU1; the lists are
# walked by gs_walk.c alone
GS_PC    += gs_core.c gs_vu1.c
GS_SRC   := $(filter-out $(addprefix port/src/gs/,$(GS_PC)),$(sort $(wildcard port/src/gs/*.c)))
# (the data check, plat_verify.c and plat_fprint.c, left out: port/src/null/verify_null.c)
# (and the PSS decoder, plat_mpeg2.c: the Dreamcast plays the converted movies, plat_movie.c)
# (and the screen reader's game side, a11y_game.c, and the heap report, plat_heapstat.c: port/src/null/extras_null.c)
# (and the songs and stages added from outside the disc, plat_songs.c and plat_stages.c: songs_null.c, stages_null.c)
PC_SRC   := $(filter-out port/src/plat_crash.c port/src/plat_verify.c port/src/plat_fprint.c port/src/plat_mpeg2.c port/src/a11y_game.c port/src/plat_heapstat.c port/src/plat_songs.c port/src/plat_stages.c port/src/plat_libm.c,$(sort $(wildcard port/src/*.c)))
DC_SRC   := $(sort $(wildcard port/src/dc/*.c)) $(addprefix port/src/null/,audio_null.c net_null.c texpack_null.c window_null.c input_null.c verify_null.c songs_null.c stages_null.c menutext_null.c extras_null.c)

GAME_OBJ := $(foreach f,$(GAME_SRC),$(OBJ)/$(subst /,_,$(patsubst src/%.c,%,$(f))).o)
NL_OBJ   := $(patsubst port/third_party/newlib_libm/%.c,$(OBJ)/nl_%.o,$(NL_SRC))
GS_OBJ   := $(patsubst port/src/gs/%.c,$(OBJ)/gs_%.o,$(GS_SRC))
PC_OBJ   := $(patsubst src/port/%.c,$(OBJ)/pc_%.o,$(VU0_SRC)) $(patsubst port/src/%.c,$(OBJ)/pc_%.o,$(PC_SRC))
DC_OBJ   := $(foreach f,$(DC_SRC),$(OBJ)/dc_$(basename $(notdir $(f))).o)
OBJS     := $(GAME_OBJ) $(GS_OBJ) $(PC_OBJ) $(DC_OBJ)

# ------------------------------------------------------------------------------------------------------ the flags

# kos-cc adds KOS's own (-m4-single -ml -ffast-math ...); C's float rules rather than
# -ffast-math, so the game's maths is the PC build's in what it means (sh4zam emits its fsca / fsrra / fipr / ftrv by
# inline asm without it); -Os (the program's size is RAM the 32 MB Dreamcast does not have), the renderer -O3 (RENDER_OBJ); -fno-math-errno: sqrtf the SH4's fsqrt, not a call (the same value: errno unread)
# link-time optimisation over the whole program (DC_LTO=0: without, every object rebuilt; the link's files in $(BUILD)/tmp)
DC_LTO      ?= 1
LTO_FLAG    := $(if $(filter 1,$(DC_LTO)),-flto=8,-fno-lto)
DC_FLAGS    := $(LTO_FLAG) -Os -g -fno-fast-math -fno-math-errno -ffp-contract=off -fno-strict-aliasing -DPORT_GAME_HARD_FLOAT
# (game code without -w: a call to a function not declared is an error, see Makefile)
GAME_CFLAGS := $(DC_FLAGS) -Wno-attributes -Werror=implicit-function-declaration -std=gnu23 -fgnu89-inline -Wno-error=incompatible-pointer-types -Wno-error=return-mismatch -c -fcommon -Drand=Port_Rand -Dsrand=Port_Srand -iquote include -Iport/include -include port_compat.h -include dc_vec_inline.h
# (the game's C as C23: what sh4zam's headers need, in dc_vec_inline.h; -fgnu89-inline: inline as the PS2's compiler
# took it, an external copy too (EftMesh_IsOffScreen); the two errors C99 made of gnu89's warnings warnings again)
NL_CFLAGS   := $(DC_FLAGS) -w -std=gnu89 -c -fno-builtin -Iport/include -Iport/third_party/newlib_libm -include newlib_shim.h
GS_CFLAGS   := $(DC_FLAGS) -w -std=gnu99 -c -I$(GEN_GS) -Iport/src/dc -MMD -MP
PC_CFLAGS   := $(DC_FLAGS) -std=gnu99 -c -iquote include -Iport/include -Iport/src -Iport/src/dc
PC_SOFT     := -DSF_FAST_CALLS -include math.h -include stdlib.h -Drand=Port_Rand -Dsrand=Port_Srand
PC_HARD     := plat_libm plat_fastvec vu1_native vu0_native

CC_EE := $(PYTHON) port/tools/cc_ee.py

# ------------------------------------------------------------------------------------------------------ the rules

.PHONY: all clean dc-assets disc
.DELETE_ON_ERROR:

all: $(EXE)

$(OBJ):
	mkdir -p $@

# the data tables: the PC build's assembly (gen_data.py), assembled for the SH-4
$(DATA)/.stamp: port/build/gen/data port/tools/dc_data.py
	$(PYTHON) port/tools/dc_data.py $(DATA)
	touch $@

$(OBJ)/main.o: src/main.c | $(OBJ)
	$(CC_EE) --game --dc-inline port/include/dc_vec_inline.h $@ $< -- $(CC) $(GAME_CFLAGS) -I$(<D)
$(OBJ)/sys_%.o: src/sys/%.c | $(OBJ)
	$(CC_EE) --game --dc-inline port/include/dc_vec_inline.h $@ $< -- $(CC) $(GAME_CFLAGS) -I$(<D)
$(OBJ)/battle_%.o: src/battle/%.c | $(OBJ)
	$(CC_EE) --game --dc-inline port/include/dc_vec_inline.h $@ $< -- $(CC) $(GAME_CFLAGS) -I$(<D)
$(OBJ)/menu_%.o: src/menu/%.c | $(OBJ)
	$(CC_EE) --game --dc-inline port/include/dc_vec_inline.h $@ $< -- $(CC) $(GAME_CFLAGS) -I$(<D)

$(OBJ)/nl_%.o: port/third_party/newlib_libm/%.c | $(OBJ)
	$(CC_EE) $@ $< -- $(CC) $(NL_CFLAGS)

$(OBJ)/gs_%.o: port/src/gs/%.c | $(OBJ)
	$(CC) $(GS_CFLAGS) $< -o $@
# the renderer: the PVR back end, the list walk, the meshes (VU1's programs), the records and their state, the
# vector maths
RENDER_OBJ := $(addprefix $(OBJ)/,gs_gs_pvr.o gs_gs_draw.o gs_gs_walk.o pc_vu1_native.o pc_vu0_native.o pc_rnd_gs.o pc_gs_marker.o pc_rnd_fx.o pc_plat_fastvec.o)
$(filter $(OBJ)/gs_%,$(RENDER_OBJ)): GS_CFLAGS += -O3
$(filter $(OBJ)/pc_%,$(RENDER_OBJ)): PC_CFLAGS += -O3
$(OBJ)/gs_gs_pvr.o: GS_CFLAGS += -DBT3_PVR
$(OBJ)/gs_gs_draw.o: GS_CFLAGS += -DBT3_PVR
# DC_RTT=1: drawing into frame buffers and reading them (the screen effects, the cross-fade); off, they are left out
# (BT3_NO_RTT: port/src/rnd_fx.c Rnd_FxOn, gs/gs_pvr.c no_rtt, gs/gs_walk.c Gs_StoreImage; gs/gs_draw.h: lists for a
# part of a frame, which the PVR draws as they fill)
DC_RTT ?= 0
RTT_STAMP := $(BUILD)/rtt_$(DC_RTT).stamp
RTT_OBJS := $(OBJ)/pc_rnd_fx.o $(OBJ)/gs_gs_pvr.o $(OBJ)/gs_gs_walk.o $(OBJ)/gs_gs_draw.o
$(RTT_STAMP): | $(OBJ)
	rm -f $(BUILD)/rtt_*.stamp
	touch $@
$(RTT_OBJS): $(RTT_STAMP)
$(OBJ)/pc_rnd_fx.o: PC_CFLAGS += $(if $(filter 1,$(DC_RTT)),,-DBT3_NO_RTT)
$(OBJ)/gs_gs_pvr.o $(OBJ)/gs_gs_walk.o $(OBJ)/gs_gs_draw.o: GS_CFLAGS += $(if $(filter 1,$(DC_RTT)),,-DBT3_NO_RTT)
# DC_MOVIE=1: the movies played (pl_mpeg, port/src/plat_movie.c; dc-assets converts them); off, they end at once
DC_MOVIE ?= 0
MOVIE_STAMP := $(BUILD)/movie_$(DC_MOVIE).stamp
$(MOVIE_STAMP): | $(OBJ)
	rm -f $(BUILD)/movie_*.stamp
	touch $@
$(OBJ)/pc_plat_movie.o: $(MOVIE_STAMP)
$(OBJ)/pc_plat_movie.o: PC_CFLAGS += $(if $(filter 1,$(DC_MOVIE)),,-DBT3_NO_MOVIE)
# DC_PROF=1: the whole program sampled 1000 times a second, the histogram printed every 20 s (port/src/dc/dc_prof.c;
# port/tools/dc_prof.py names the functions)
DC_PROF ?= 0
PROF_STAMP := $(BUILD)/prof_$(DC_PROF).stamp
$(PROF_STAMP): | $(OBJ)
	rm -f $(BUILD)/prof_*.stamp
	touch $@
$(OBJ)/dc_dc_prof.o $(OBJ)/gs_gs_walk.o: $(PROF_STAMP)
$(OBJ)/dc_dc_prof.o: PC_CFLAGS += $(if $(filter 1,$(DC_PROF)),-DBT3_PROF)
$(OBJ)/gs_gs_walk.o: GS_CFLAGS += $(if $(filter 1,$(DC_PROF)),-DBT3_PROF)
# DC_NODRAW=1 (a test): the frame's draws and meshes not made, an empty frame shown; the game's code as ever (gs_walk.c)
DC_NODRAW ?= 0
NODRAW_STAMP := $(BUILD)/nodraw_$(DC_NODRAW).stamp
$(NODRAW_STAMP): | $(OBJ)
	rm -f $(BUILD)/nodraw_*.stamp
	touch $@
$(OBJ)/gs_gs_walk.o: $(NODRAW_STAMP)
$(OBJ)/gs_gs_walk.o: GS_CFLAGS += $(if $(filter 1,$(DC_NODRAW)),-DBT3_NODRAW)
# DC_NOSTAGE=1 (a test): the stage's models not drawn (src/battle/stgm_a.c StgModel_Draw); the fighters, effects and HUD as ever
DC_NOSTAGE ?= 0
NOSTAGE_STAMP := $(BUILD)/nostage_$(DC_NOSTAGE).stamp
$(NOSTAGE_STAMP): | $(OBJ)
	rm -f $(BUILD)/nostage_*.stamp
	touch $@
$(OBJ)/battle_stgm_a.o: $(NOSTAGE_STAMP)
$(OBJ)/battle_stgm_a.o: GAME_CFLAGS += $(if $(filter 1,$(DC_NOSTAGE)),-DBT3_NOSTAGE)
# DC_OLDSTAGE=1: the stage's groups 0..5 drawn the old way, through the VU1 emulation, not natively
# (port/src/dc/stg_native.c; src/battle/stgm_a.c StgModel_Draw)
DC_OLDSTAGE ?= 0
OLDSTAGE_STAMP := $(BUILD)/oldstage_$(DC_OLDSTAGE).stamp
$(OLDSTAGE_STAMP): | $(OBJ)
	rm -f $(BUILD)/oldstage_*.stamp
	touch $@
$(OBJ)/battle_stgm_a.o $(OBJ)/battle_stg_d_b.o $(OBJ)/dc_stg_native.o: $(OLDSTAGE_STAMP)
$(OBJ)/battle_stgm_a.o $(OBJ)/battle_stg_d_b.o: GAME_CFLAGS += $(if $(filter 1,$(DC_OLDSTAGE)),-DBT3_OLDSTAGE)
$(OBJ)/dc_stg_native.o: PC_CFLAGS += $(if $(filter 1,$(DC_OLDSTAGE)),-DBT3_OLDSTAGE)
# DC_NOFIG=1 (a test): the fighters' models not drawn (src/sys/gfxm_d_c.c ObjDraw_DrawParts); the stage, effects and HUD as ever
DC_NOFIG ?= 0
NOFIG_STAMP := $(BUILD)/nofig_$(DC_NOFIG).stamp
$(NOFIG_STAMP): | $(OBJ)
	rm -f $(BUILD)/nofig_*.stamp
	touch $@
$(OBJ)/sys_gfxm_d_c.o: $(NOFIG_STAMP)
$(OBJ)/sys_gfxm_d_c.o: GAME_CFLAGS += $(if $(filter 1,$(DC_NOFIG)),-DBT3_NOFIG)
# DC_DEMO=1 (the default for now: no pad yet): the attract demo's fight at start, as BT3_DEMO on PC; DC_DEMO=0 the game
DC_DEMO ?= 1
$(OBJ)/pc_headless.o: PC_CFLAGS += $(if $(filter 1,$(DC_DEMO)),-DBT3_DC_DEMO)
$(OBJ)/pc_headless.o: $(if $(filter 1,$(DC_DEMO)),$(OBJ)/.demo_on,$(OBJ)/.demo_off)
$(OBJ)/.demo_on $(OBJ)/.demo_off:
	mkdir -p $(OBJ) && rm -f $(OBJ)/.demo_on $(OBJ)/.demo_off && touch $@

# (weak: a routine port/src/vu0_native.c has, the SH4's own, is linked in its place; #pragma weak for each of the
# names vu0_names.h gives them, which LTO keeps, as objcopy --weaken on the object did not)
$(OBJ)/vu0_weak.h: port/src/vu0_names.h | $(OBJ)
	sed -n 's/^#define Ref_[A-Za-z0-9_]* \([A-Za-z0-9_]*\)$$/#pragma weak \1/p' $< > $@
$(OBJ)/pc_vu0_%.o: src/port/vu0_%.c $(OBJ)/vu0_weak.h Makefile.dc | $(OBJ)
	$(CC) $(PC_CFLAGS) $(PC_SOFT) -include vu0_names.h -include $(OBJ)/vu0_weak.h -DREF_VU0_EXTERN_ARITH -MMD -MP $< -o $@
$(OBJ)/pc_%.o: port/src/%.c | $(OBJ)
	$(if $(filter $*,$(PC_HARD)),$(CC) $(PC_CFLAGS) -MMD -MP $< -o $@,$(CC_EE) $@ $< -- $(CC) $(PC_CFLAGS) $(PC_SOFT))

$(OBJ)/dc_%.o: port/src/dc/%.c | $(OBJ)
	$(CC) $(PC_CFLAGS) -MMD -MP $< -o $@
$(OBJ)/dc_%_null.o: port/src/null/%_null.c | $(OBJ)
	$(CC) $(PC_CFLAGS) -MMD -MP $< -o $@

# the link, with a stub for each symbol still missing
# (link_dc.py links every object of the folder: those of sources no longer built are removed first)
LTO_STAMP := $(BUILD)/lto_$(DC_LTO).stamp
$(LTO_STAMP): | $(OBJ)
	rm -f $(BUILD)/lto_*.stamp
	touch $@
$(OBJS): $(LTO_STAMP)
# (every object made again when the flags or the game's compile step change: a flag is not a file make sees)
$(OBJS): Makefile.dc port/tools/cc_ee.py
$(EXE): $(OBJS) $(DATA)/.stamp port/tools/link_dc.py
	rm -f $(filter-out $(OBJS),$(wildcard $(OBJ)/*.o))
	mkdir -p $(BUILD)/tmp && TMPDIR=$(abspath $(BUILD)/tmp) BT3_LTO_FLAG=$(LTO_FLAG) $(PYTHON) port/tools/link_dc.py $(EXE) $(OBJ) $(DATA)

# the disc's textures as the PVR takes them (port/tools/dc_tex.c), from the data `make extract` wrote; run it
# again to convert them again
HOSTCC ?= cc
ASSETS := $(BUILD)/assets
dc-assets: $(ASSETS)/tex.pak $(if $(filter 1,$(DC_MOVIE)),$(ASSETS)/ZS3USOP.mpg $(ASSETS)/ZS3USED.mpg)
# the movies as pl_mpeg plays them (port/tools/dc_movie.sh: MPEG-1, with ffmpeg)
$(ASSETS)/%.mpg: gamedata/disc/DATA/%.PSS port/tools/dc_movie.sh
	mkdir -p $(ASSETS)
	port/tools/dc_movie.sh $< $@
$(ASSETS)/tex.pak: port/tools/dc_tex.c Makefile.dc
	mkdir -p $(ASSETS)
	$(HOSTCC) -O2 -o $(BUILD)/dc_tex $<
	$(BUILD)/dc_tex $@ gamedata/pzs3us0 gamedata/pzs3us1 gamedata/pzs3us2

# make -f Makefile.dc disc: the program and the data on a selfboot disc image (port/build/dc/disc/bt3.cdi, mkdcdisc),
# as the game reads it from /cd (port/src/plat_file.c): partitions 0 and 1 as `make extract` wrote them
# (pzs3usN/NNNNN.bin), the disc's loose data (disc/DATA, without the PS2 movies and their sound), the PVR's textures
# (tex.pak) and the movies as pl_mpeg plays them (if made). No sound files (partition 2, 1.07 GB): there is no sound
# output yet, and a stream lasts the original's length without its file (gs/snd_adx.c by_table). The files are
# hard links into gamedata. About 2 GB, for Flycast. mkdcdisc copies the data to TMPDIR first (/tmp is often in
# memory: here a folder of the build) and takes about 3.5 GB of memory itself; it is stopped past 4 GB. Needs
# dc-assets first.
MKDCDISC ?= mkdcdisc
DISC_DIR := $(BUILD)/disc
DISC_FS  := $(DISC_DIR)/data
disc: $(EXE)
	@test -f $(ASSETS)/tex.pak || { echo "no $(ASSETS)/tex.pak: make -f Makefile.dc dc-assets" >&2; exit 1; }
	rm -rf $(DISC_DIR) && mkdir -p $(DISC_FS)/disc/DATA $(DISC_DIR)/tmp
	cp -al gamedata/pzs3us0 gamedata/pzs3us1 $(DISC_FS)/
	for f in gamedata/disc/DATA/*; do case "$$f" in *.PSS|*.ADX) ;; *) ln "$$f" $(DISC_FS)/disc/DATA/ ;; esac; done
	ln $(ASSETS)/tex.pak $(DISC_FS)/
	for f in $(wildcard $(ASSETS)/*.mpg); do ln "$$f" $(DISC_FS)/; done
	ulimit -v 4194304 && TMPDIR=$(abspath $(DISC_DIR)/tmp) $(MKDCDISC) -e $(EXE) -D $(DISC_FS) -o $(DISC_DIR)/bt3.cdi -n "Budokai Tenkaichi 3" -N
	rm -rf $(DISC_FS) $(DISC_DIR)/tmp

clean:
	rm -rf $(BUILD)

-include $(OBJS:.o=.d)
